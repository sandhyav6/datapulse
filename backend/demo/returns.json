{
  "dataset": "returns",
  "columns": {
    "return_id":        {"type": "string",  "required": true},
    "return_date":      {"type": "date",    "required": true, "formats": ["%Y-%m-%d"]},
    "product_category": {"type": "string",  "required": true, "normalise": "title"},
    "quantity":         {"type": "integer", "required": true, "min": 1},
    "refund_amount":    {"type": "decimal", "required": true, "min": 0},
    "reason":           {"type": "string",  "required": true, "normalise": "lower"}
  },
  "dedup_key": "return_id",
  "dedup_policy": "keep_first",
  "measure": "refund_amount",
  "metrics": {"total_refunds": "sum", "avg_refund": "mean"},
  "aggregates": {
    "daily_refunds":      {"type": "daily", "column": "return_date"},
    "refunds_by_reason":  {"type": "group", "column": "reason"}
  }
}
