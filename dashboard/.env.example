# Copy to dashboard/.env (or run: python scripts/make_dashboard_env.py)
AWS_PROFILE=etl-dashboard
AWS_REGION=ap-south-1
BUCKET_NAME=etl-pipeline-<account-id>-ap-south-1
TABLE_NAME=etl-jobs-dev
QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/etl-jobs-dev
DLQ_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/etl-jobs-dlq-dev
LOG_GROUP=/aws/lambda/etl-processor-dev
# V2 only (EnableAnalytics=true)
ATHENA_WORKGROUP=
GLUE_DATABASE=
DISPLAY_TZ=Asia/Kolkata
