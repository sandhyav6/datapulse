{
  "dataset": "world_population",
  "description": "Total population per country and per World Bank aggregate (World, regions, income groups), one row per entity and year.",
  "load_type": "snapshot",
  "columns": {
    "country_name": {
      "type": "string",
      "required": true
    },
    "country_code": {
      "type": "string",
      "required": true,
      "normalise": "upper"
    },
    "year": {
      "type": "integer",
      "required": true,
      "min": 1900
    },
    "value": {
      "type": "integer",
      "required": true,
      "min": 0
    }
  },
  "dedup_key": [
    "country_code",
    "year"
  ],
  "dedup_policy": "keep_first",
  "measure": "value",
  "metrics": {
    "largest_population": "max",
    "rows": "count"
  },
  "aggregates": {
    "world_population_by_year": {
      "type": "yearly",
      "column": "year",
      "func": "sum",
      "where": {
        "country_code": "WLD"
      }
    },
    "india_population_by_year": {
      "type": "yearly",
      "column": "year",
      "func": "sum",
      "where": {
        "country_code": "IND"
      }
    },
    "china_population_by_year": {
      "type": "yearly",
      "column": "year",
      "func": "sum",
      "where": {
        "country_code": "CHN"
      }
    },
    "peak_population_by_country": {
      "type": "group",
      "column": "country_name",
      "func": "max",
      "exclude": {
        "country_code": [
          "AFE",
          "AFW",
          "ARB",
          "CEB",
          "CSS",
          "EAP",
          "EAR",
          "EAS",
          "ECA",
          "ECS",
          "EMU",
          "EUU",
          "FCS",
          "HIC",
          "HPC",
          "IBD",
          "IBT",
          "IDA",
          "IDB",
          "IDX",
          "INX",
          "LAC",
          "LCN",
          "LDC",
          "LIC",
          "LMC",
          "LMY",
          "LTE",
          "MEA",
          "MIC",
          "MNA",
          "NAC",
          "OED",
          "OSS",
          "PRE",
          "PSS",
          "PST",
          "SAS",
          "SSA",
          "SSF",
          "SST",
          "TEA",
          "TEC",
          "TLA",
          "TMN",
          "TSA",
          "TSS",
          "UMC",
          "WLD"
        ]
      }
    }
  },
  "aggregates_note": "The source mixes 217 countries/territories with 47 World Bank aggregates (World, regions, income groups). Country-level aggregates exclude the World Bank aggregate codes so regions are never ranked as countries."
}
